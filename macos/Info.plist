<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Brocolis.app — description du bundle de l'application de bureau.

    Assemblé par .github/workflows/macos-cli-release.yml :
      Brocolis.app/Contents/Info.plist        ce fichier (__VERSION__ remplacé)
      Brocolis.app/Contents/MacOS/brocolis-app l'application (universelle)
      Brocolis.app/Contents/MacOS/brocolis     la ligne de commande, appelée
                                               avec les droits administrateur
                                               pour `on` / `off`
      Brocolis.app/Contents/Resources/brocolis.icns
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Brocolis</string>
    <key>CFBundleDisplayName</key>
    <string>Brocolis</string>
    <key>CFBundleIdentifier</key>
    <string>com.maxlestage.brocolis.app</string>
    <key>CFBundleExecutable</key>
    <string>brocolis-app</string>
    <key>CFBundleIconFile</key>
    <string>brocolis</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>fr</string>
        <string>en</string>
        <string>es</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© Maxime Nathan Lestage</string>
</dict>
</plist>
