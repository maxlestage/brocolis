#!/bin/sh
# Brocolis — wrapper postinstall .pkg.
#
# Délègue à install.sh (placé à côté par pkgbuild via --scripts), qui fait
# le vrai setup système : trousseau, politique Firefox, .mobileconfig,
# config, état persisté dans /var/lib/brocolis/state.env. --enable-launchd
# active le LaunchDaemon (déjà déposé par la payload du .pkg).
#
# Garder la délégation minimale : la logique d'install (idempotence,
# détection, ordre) reste mutualisée avec macos/install.sh.
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/install.sh" --enable-launchd
