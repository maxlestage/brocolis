/target
.DS_Store

# Artefacts d'exécution / secrets (ne jamais committer)
/brocolis.toml
*-ca.crt
*-ca.key
brocolis-ca.*
# Clé privée X25519 d'appairage (générée par `brocolis pair`).
*-x25519.key
brocolis-x25519.*

# Paquets Linux générés par linux/build-packages.sh
/linux/dist/

# Déploiement Node / Heroku
/node_modules
# Dépendances du harnais de vérification navigateur (tests/browser).
/tests/browser/node_modules
