{
  "name": "brocolis-site-heroku",
  "private": true,
  "description": "Déploiement Heroku du site vitrine Brocolis (application WebAssembly servie en statique).",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build:site": "cd site && trunk build --release",
    "heroku-postbuild": "node scripts/check-dist.mjs",
    "start": "node server.js",
    "test": "node --test tests/server.test.mjs",
    "test:browser": "npm --prefix tests/browser test"
  }
}
